# .env.example - Template for environment variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to GitHub.

# Your GitHub Personal Access Token.
# Required to make authenticated GitHub API requests.
# Without this, you are limited to 60 requests per hour (unauthenticated).
# With it, you get 5000 requests per hour.
#
# How to create one:
#   1. Go to https://github.com/settings/tokens
#   2. Click "Generate new token" → "Generate new token (classic)"
#   3. Give it a name like "ai-archaeologist"
#   4. Select ONLY the "public_repo" scope (read-only access to public repos)
#   5. Click "Generate token"
#   6. Copy the token immediately — GitHub will never show it again
#   7. Paste it below in your .env file

GITHUB_TOKEN=

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=True
